# ==============================================================================
# MacVoice Website Environment Configuration
# ==============================================================================

# Polar API & Checkout Configuration (https://polar.sh)
# Your Polar Organization Access Token (generated in Polar Dashboard -> Settings -> Access Tokens)
POLAR_API_KEY=polar_oat_your_organization_access_token_here

# Polar Webhook Signing Secret (generated when creating a webhook endpoint in Polar Dashboard)
POLAR_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Polar Product ID for MacVoice $9 Lifetime License (UUID from Polar Dashboard -> Products)
POLAR_PRODUCT_ID=your_polar_product_uuid_here

# Optional: Direct Polar Checkout URL (e.g., https://buy.polar.sh/polar_cl_...)
# POLAR_CHECKOUT_URL=https://buy.polar.sh/...

# Polar Environment: "production" (default) or "sandbox"
POLAR_ENVIRONMENT=production

# Tamper-Proof Download Token Signing Secret
# A strong random 64-character secret used to generate HMAC-SHA256 signed download tokens:
DOWNLOAD_SIGNING_SECRET=generate_a_random_32_or_64_character_secret_key_for_production

# Release Package Path Override (optional)
# Defaults to public/releases/MacVoice.dmg if not set:
# DMG_FILE_PATH=/absolute/path/to/MacVoice.dmg

# Public Application Base URL
NEXT_PUBLIC_APP_URL=https://macvoice.akshatt.in
